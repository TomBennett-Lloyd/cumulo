# Copy to forecast.auto.tfvars (gitignored). Terraform loads *.auto.tfvars
# automatically for every command run in this directory, so there is no
# -var-file flag to remember or forget.
#
# Must be the same region as the storage and ingestion stacks: this stack's IAM
# policy names storage's tables and ingestion's queue by ARN, and both a table
# ARN and a queue ARN are regional.

aws_region = "eu-west-1"

# Optional. Defaults to "dev", and appears in the function, log group,
# execution role and deploy-policy names — and in the storage table names and
# the ingestion queue name the IAM policy grants access to, and in the
# CUMULO_ENV the function resolves table names from at runtime. Must match the
# storage and ingestion stacks' `environment` or the grants, the lookups and
# the event source mapping all point at resources that do not exist.
# environment = "dev"
