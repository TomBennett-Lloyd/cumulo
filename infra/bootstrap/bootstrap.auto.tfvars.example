# Copy to bootstrap.auto.tfvars (gitignored). Terraform loads *.auto.tfvars
# automatically for every command run in this directory, so there is no -var-file
# flag to remember or forget.

aws_region = "eu-west-1"

# Optional. Defaults to TomBennett-Lloyd/cumulo; only set it if you are pointing
# the trust policy at a fork.
# github_repository = "TomBennett-Lloyd/cumulo"

# Optional, but MANDATORY for a fork: GitHub's immutable subject prefix, which
# embeds numeric owner and repo ids and so cannot be guessed from the names. The
# default is this repository's; a fork's tokens will never match it. Read yours:
#   gh api repos/OWNER/REPO/actions/oidc/customization/sub --jq .sub_claim_prefix
# github_subject_prefix = "repo:OWNER@000000/REPO@0000000"
