# Copy to api.auto.tfvars (gitignored). Terraform loads *.auto.tfvars
# automatically for every command run in this directory, so there is no
# -var-file flag to remember or forget.
#
# Must be the same region as the storage stack: this stack's IAM policy names
# storage's tables by ARN, and a table ARN is regional.

aws_region = "eu-west-1"

# Optional. Defaults to "dev", and appears in the function, log group, HTTP API,
# execution role and deploy-policy names — and in the storage table names the
# IAM policy grants access to, and in the CUMULO_ENV the function resolves table
# names from at runtime. Must match the storage stack's `environment` or the
# grants and the lookups both point at tables that do not exist.
# environment = "dev"

# Optional, empty by default. Comma-separated browser origins allowed to call
# the write routes, beyond the API's own (which it always allows). Add a dev
# machine's Vite origin here to add sites from `pnpm dev` against this
# deployment — see apps/web/.env.example for the other half of that pairing.
# This is friction, not authentication: it stops a drive-by script and a
# cross-site page, and nothing that sets its own Origin header (ADR 0006 records
# that as a stated non-goal).
#
# Once #144's web stack is applied, the hosted SPA's origin joins the dev one —
# the deployed demo is served from CloudFront and calls this API cross-origin,
# so its origin has to be admitted here too:
#
# web_origins = "http://localhost:5173,https://<distribution-domain>.cloudfront.net"
#
# The domain is server-assigned by CloudFront, so read it rather than predicting
# it (from the repo root):
#
#   terraform -chdir=infra/web output -raw cloudfront_url
#
# That output is already a bare origin — scheme and host, no path — so it goes
# in as printed. Add nothing after it: the validation in variables.tf rejects a
# trailing slash, a path, and any whitespace around the comma, because the
# function splits this exact string and compares it to a browser's Origin
# header, which carries none of them.
#
# While #285's interim GitHub Pages hosting is live, that origin joins the list
# too — scheme and host only, no path, or the validation above rejects it. Read
# it back rather than predicting it, and strip the path:
#
#   gh api repos/TomBennett-Lloyd/cumulo/pages --jq .html_url
#
# It comes out of the list again at #144's teardown — see the header of
# .github/workflows/deploy-pages.yml for the full teardown list.
# web_origins = "http://localhost:5173"
