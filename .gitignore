# Dependencies & build output
node_modules/
dist/
coverage/
*.tsbuildinfo

# Playwright's browser-lane output (apps/web/e2e): traces, screenshots and the
# HTML report, all written only when a run fails and all regenerated by the next
# run. Unanchored so they match wherever a config puts them.
test-results/
playwright-report/

# Agent git worktrees (created by .claude tooling inside the repo)
.claude/worktrees/

# pvlib golden-fixture generator (tools/pvlib-fixtures) — an offline, human-run
# Python environment. Never in CI, never on the deploy path; the fixtures it
# writes are committed, the environment that produced them is not.
tools/pvlib-fixtures/.venv/
__pycache__/

# Environment & secrets
.env
.env.*
!.env.example

# OS / editor noise
.DS_Store
*.log

# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.auto.tfvars.example
# Account-specific backend config; backend.hcl.example is committed instead.
backend.hcl
# Override files swap the S3 backend for a local one during first apply and
# teardown (see infra/README.md). They must never reach a PR.
override.tf
override.tf.json
*_override.tf
*_override.tf.json
