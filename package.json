{
  "name": "cumulo",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "pnpm lint:js && pnpm lint:css && pnpm lint:sh",
    "lint:js": "eslint --max-warnings 0 .",
    "lint:css": "stylelint \"**/*.css\" --max-warnings 0",
    "lint:sh": "bash .claude/scripts/lint-shell.sh",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "test:scripts": "bash .claude/scripts/worktree-lifecycle.test.sh && bash .claude/scripts/check-adr-index.test.sh && bash .claude/scripts/lint-shell.test.sh",
    "check:adr-index": "bash .claude/scripts/check-adr-index.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm check:adr-index && pnpm test:scripts && pnpm format:check",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true"
  },
  "lint-staged": {
    "*.{ts,tsx,mts,cts}": "eslint --no-warn-ignored --max-warnings 0 --cache --cache-location node_modules/.cache/eslint-precommit/",
    "*.css": "stylelint --max-warnings 0",
    "*": "prettier --check --ignore-unknown"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6",
    "stylelint": "^17.14.1",
    "stylelint-declaration-strict-value": "^1.11.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  }
}
