{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "resolveJsonModule": true,
    // Ambient globals are opted into explicitly: with `types` unset this toolchain
    // pulls nothing from `node_modules/@types`, so `console` and `process` fail to
    // resolve. This app runs on Node, so it names `node` — and nothing else, which
    // keeps browser globals out of a service that has no DOM.
    "types": ["node"]
  },
  // `vitest.config.ts` joins the compiled surface for the same reason
  // `packages/storage/tsconfig.json` includes its own: the root eslint
  // `projectService` type-checks every file it lints, and a config left outside
  // the program is a parse error rather than a lint pass.
  "include": ["src", "vitest.config.ts"]
}
