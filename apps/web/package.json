{
  "name": "@cumulo/web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint --max-warnings 0 . && stylelint \"**/*.css\" --max-warnings 0",
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit && tsc -p e2e",
